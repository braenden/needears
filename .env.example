# Copy to .env.local and fill in. Never commit real values.
# Local values come from `supabase status` after `supabase start`.

# Public URL of the site, used for auth redirects and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Locally the API runs on port 54421 (see supabase/config.toml).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# Anon (publishable) key. Safe in the browser, access is limited by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (secret) key. Server only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2, where the audio is stored (S3 API). Server only: browsers get
# presigned URLs for one file at a time. In production the endpoint is
# https://<account id>.eu.r2.cloudflarestorage.com and the keys belong to an
# R2 API token with Object Read & Write on this bucket only. Locally,
# `pnpm r2:start` runs an S3 compatible stand-in with the values below.
R2_ENDPOINT=http://127.0.0.1:54430
R2_ACCESS_KEY_ID=needears-local
R2_SECRET_ACCESS_KEY=needears-local-secret
R2_BUCKET=needears-audio

# Google sign-in (Google Identity Services). The client ID of an OAuth client
# of type "Web application" in Google Cloud Console (APIs & Services >
# Credentials), with the site's origin (https://needears.com, and
# http://localhost:3000 for local work) under Authorized JavaScript origins.
# The same client ID must be set for the Google provider in Supabase.
# Leave empty to offer only the email link. Read at runtime, so a change
# needs a restart, not a new build.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The same OAuth client's secret, only on the server. Connecting a Google
# account in Settings swaps Google's one time code for its ID token with it.
# Leave empty to offer Google for signing in only.
GOOGLE_CLIENT_SECRET=

# Shared secret Vercel Cron sends to /api/cron/* (any long random string).
CRON_SECRET=

# Resend, for transactional email (notifications). Auth email goes through Supabase SMTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Sentry error monitoring, off when SENTRY_DSN is empty. The DSN is public (it is
# sent to the browser); the auth token is only used at build time to upload source maps.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
